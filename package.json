{
  "name": "@johnasblasco/vibecode",
  "version": "0.1.0",
  "description": "Guided project setup and safe project files for beginners",
  "author": "johnasblasco",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=26.13.0 <27" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "vibecode": "node dist/cli/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tooling": "node --test tests/tooling/skeleton.node.test.mjs",
    "test:dependencies": "node --test tests/tooling/dependencies.node.test.mjs",
    "test:security": "node --test tests/tooling/security.node.test.mjs",
    "test:release": "node --test tests/tooling/release.node.test.mjs",
    "release:pack": "node tools/create-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "15.0.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
