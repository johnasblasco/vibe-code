# Copy to .env for local work. Values here are fake. Real values live in your host's settings.
# Variables with a public prefix are visible to every visitor. Never give a secret that prefix.

NODE_ENV=development
APP_URL=http://localhost:3000

# Local database (disposable). Production uses a different value set only in the host dashboard.
POSTGRES_USER={{project_slug}}
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB={{project_slug}}
DATABASE_URL=postgresql://{{project_slug}}:change-me-local-only@127.0.0.1:5432/{{project_slug}}
