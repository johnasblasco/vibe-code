# Optional local Redis service. Use only after explicitly choosing Redis and reviewing its licence.
# Supply REDIS_PASSWORD through local environment settings; do not put credentials in this file.
services:
  cache:
    image: redis:{{redis_image_tag}}
    command: ["redis-server", "--requirepass", "${REDIS_PASSWORD:?Set REDIS_PASSWORD locally}"]
    ports:
      - "127.0.0.1:6379:6379"
