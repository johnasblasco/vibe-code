# Local development services only. Ports are bound to this computer, not your network.
services:
  db:
    image: postgres:{{postgres_image_tag}}
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - ./docker-data/postgres:{{postgres_data_directory}}
    healthcheck:
      test: ["CMD", "pg_isready", "-U", "${POSTGRES_USER}", "-d", "${POSTGRES_DB}"]
      interval: 5s
      timeout: 3s
      retries: 10

  # An explicitly selected Redis cache is generated separately in docker-compose.cache.yml.
